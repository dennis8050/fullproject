# ============================
# 🔒 SECURITY / SECRETS
# ============================

# Terraform state and caches
.terraform/
*.tfstate
*.tfstate.backup
*.tfvars
*.tfvars.json

# Terraform providers
terraform/**/terraform-provider-*

# AWS / Cloud credentials
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx

# Environment files
.env
.env.local
.env.*.local
*.secret
*.secrets
secrets/
config/secrets.yml

# Kubernetes and Minikube configs
.kube/
.kube/config
.kubeconfig
kubeconfig.yaml
.k8s/
*.kubeconfig
.userapp-config.yaml
.userapp-secret.yaml

# Docker secrets and local images
.docker/
docker-compose.override.yml
**/docker-compose.override.yml

# GitHub Actions runner or local workflow files
.github/workflows/secrets.yml
.github/workflows/*.secret.yml

# ============================
# 🧑‍💻 DEVELOPMENT FILES
# ============================

# Logs and runtime files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Node.js dependencies
node_modules/
npm-cache/
yarn-cache/

# Python build and cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.db
*.sqlite3
*.egg-info/
dist/
build/

# IDE / Editor settings
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Temporary or backup files
*.tmp
*.bak
*.old
*~
